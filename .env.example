# Copy this file to .env and fill in your values.
# .env is NOT committed to version control.

# --- Required ---
FEVER_DATASET_PATH=data/sample_fever.jsonl
EVIDENCE_CORPUS_PATH=data/sample_fever.jsonl
EVAL_OUTPUT_PATH=output/eval_report.txt

# --- Optional (defaults shown) ---
RETRIEVAL_TOP_K=3
NLP_ENGINE=spacy
LLM_BACKEND=keyword
HF_MODEL_NAME=google/flan-t5-base
# OPENAI_MODEL=gpt-3.5-turbo
# LLM_API_KEY=sk-...        # Required only when LLM_BACKEND=openai
MAX_RECORDS=10
SPACY_MODEL=en_core_web_sm
JSON_OUTPUT_PATH=output/krr_results.jsonl
