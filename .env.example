# Copy this file to .env and fill in your values.
# .env is NOT committed to version control.

# --- Required ---
FEVER_DATASET_PATH=data/test.jsonl
EVIDENCE_CORPUS_PATH=data/test.jsonl
EVAL_OUTPUT_PATH=output/eval_report.txt

# --- Train/test split ---
# Set TRAIN_DATASET_PATH to build the retrieval index from training data only.
# This ensures no test data leaks into the retrieval corpus.
TRAIN_DATASET_PATH=data/train.jsonl

# --- Optional (defaults shown) ---
RETRIEVAL_TOP_K=3
# hybrid = TF-IDF (30%) + sentence-transformers/all-MiniLM-L6-v2 (70%)
# Falls back to tfidf-only if sentence-transformers is not installed
RETRIEVAL_METHOD=hybrid
NLP_ENGINE=spacy
LLM_BACKEND=keyword
HF_MODEL_NAME=google/flan-t5-base
# OPENAI_MODEL=gpt-3.5-turbo
# LLM_API_KEY=sk-...        # Required only when LLM_BACKEND=openai
SPACY_MODEL=en_core_web_sm
JSON_OUTPUT_PATH=output/krr_results.jsonl
